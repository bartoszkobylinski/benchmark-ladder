# Hidden benchmark material — defense in depth only.
# Canonical private benchmarks must live in a separate private repository
# or access-controlled store; ADR-0002 explicitly forbids relying on .gitignore
# as the secrecy boundary.
.private/
private/
benchmarks-private/
benchmark-private/
data/private/
private-results/
secrets/
*.secret
*.secret.*

# Local trusted-evaluation mounts
.local-benchmarks/
.local-private-eval/
